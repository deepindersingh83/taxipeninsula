# =============================================================================
# Taxi Peninsula — environment variables
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
#
# NEVER commit the real .env — it is already in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Port
# -----------------------------------------------------------------------------
# Which port the app listens on. Defaults to 3000 when unset.
#
# You can also set it per-run, which beats this file:
#   PORT=4500 npm start
#   npm start -- --port 4500
#
# Managed hosts (cPanel/Passenger, Docker) assign a port through the real
# environment; that always wins, so leave this blank there.
#
# Note: a handful of ports (6000, 6666, 5060, …) are on the browsers' blocked
# list and cannot be used — the app will tell you and suggest an alternative.
PORT="3000"

# -----------------------------------------------------------------------------
# Site address
# -----------------------------------------------------------------------------
# LEAVE THIS BLANK AND THE DOMAIN IS DETECTED AUTOMATICALLY from each request,
# so a fresh clone serves correctly on whatever domain it is reached by — no
# configuration needed to get running.
#
# Set it in production anyway. Two reasons:
#
#   1. Speed. With it set, pages are statically prerendered. Without it, the
#      domain has to be read per request, so pages render dynamically.
#      Correct either way, measurably faster when set.
#   2. Trust. `Host` comes from the client. Pinning the domain means a forged
#      Host header can never end up in a canonical tag or in the admin link
#      inside a booking notification email.
#
# Measured on this site: pinned it serves pages in ~6 ms; unset, ~50 ms.
# No trailing slash. Blank it out if you want pure auto-detection.
NEXT_PUBLIC_SITE_URL="https://taxipeninsula.com.au"

# -----------------------------------------------------------------------------
# Database — MySQL / MariaDB
# -----------------------------------------------------------------------------
# Create the database and user in cPanel / phpMyAdmin first, then:
#   npx prisma db push
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains @ : / ? # or %, URL-encode it (@ becomes %40).
DATABASE_URL="mysql://taxi_user:CHANGE_ME@localhost:3306/taxi_peninsula"

# -----------------------------------------------------------------------------
# Admin authentication
# -----------------------------------------------------------------------------
# REQUIRED. Generate a long random value:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# The first admin account, created by `npm run db:seed`.
# Change the password immediately after the first sign-in.
SEED_ADMIN_EMAIL="support@taxipeninsula.com.au"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Taxi Peninsula Admin"

# -----------------------------------------------------------------------------
# Google reCAPTCHA v3  (https://www.google.com/recaptcha/admin)
# -----------------------------------------------------------------------------
# Register a v3 site for taxipeninsula.com.au and paste both keys here.
# Leave blank in development and verification is skipped with a warning.
# In production, blank keys make the forms refuse to submit — fail closed.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Score below which a submission is rejected (0.0 = bot, 1.0 = human).
RECAPTCHA_MIN_SCORE="0.5"

# -----------------------------------------------------------------------------
# Email — plain SMTP
# -----------------------------------------------------------------------------
# For cPanel mail this is usually:
#   SMTP_HOST="mail.taxipeninsula.com.au"
#   SMTP_PORT="465"   with SMTP_SECURE="true"
#   SMTP_USER="support@taxipeninsula.com.au"
# Leave SMTP_HOST blank to disable sending; bookings are still saved to the
# database and the delivery failure is recorded on the booking record.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"       # "true" for port 465
SMTP_USER=""
SMTP_PASSWORD=""

# The From address must be on a domain your SMTP server is allowed to send for,
# or the mail will be marked as spam (SPF/DKIM).
MAIL_FROM="Taxi Peninsula <support@taxipeninsula.com.au>"
MAIL_TO_BOOKINGS="support@taxipeninsula.com.au"
MAIL_TO_ENQUIRIES="support@taxipeninsula.com.au"

# Send the customer a copy of their booking confirmation.
SEND_CUSTOMER_CONFIRMATION="true"

# -----------------------------------------------------------------------------
# Twilio SMS to the on-call driver
# -----------------------------------------------------------------------------
# Built and ready, but OFF by default — email is the primary notification.
# Set ENABLE_SMS="true" and fill in the four values below to switch it on.
ENABLE_SMS="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""      # e.g. "+61480000000"
DRIVER_SMS_NUMBER="+61468323211"

# -----------------------------------------------------------------------------
# Analytics & verification — paste the codes when you have them.
# Leave blank and nothing is loaded at all.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""          # e.g. "G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID=""                     # e.g. "GTM-XXXXXXX"
NEXT_PUBLIC_GSC_VERIFICATION=""           # Google Search Console meta tag content
NEXT_PUBLIC_FB_PIXEL_ID=""                # Meta Pixel, optional
